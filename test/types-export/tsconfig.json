{
  "compilerOptions": {
    "declaration": true,
    "outDir": "dist",
    "rootDir": "steps",
    "target": "es2021",
    "module": "nodenext",
    "strict": true,
    "types": ["node"],
    // Older Playwright declarations use namespace syntax rejected by TypeScript 6.
    // Consumer code and type assertions in this fixture are still checked.
    "skipLibCheck": true
  },
  "include": ["**/*.ts"]
}
